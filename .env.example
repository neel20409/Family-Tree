# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app).
# Only Firestore is used (photo/date overrides) -- Cloud Storage isn't, since
# it now requires the paid Blaze plan just to enable. These values identify
# the project; they are not secret -- the actual security boundary is
# firestore.rules. Copy this file to .env and fill in real values for local
# dev. In CI, the same names are set as GitHub repo secrets (see
# .github/workflows/deploy.yml).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (cloudinary.com) free tier, used for photo uploads instead of
# Firebase Storage. Cloud name + unsigned upload preset name are both public,
# non-secret values (same model as the Firebase config above) -- the preset's
# own settings in the Cloudinary console (allowed formats, max file size,
# overwrite behavior) are the real security boundary.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
