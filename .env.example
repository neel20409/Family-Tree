# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app).
# These values identify the project; they are not secret -- the actual security
# boundary is firestore.rules / storage.rules. Copy this file to .env and fill
# in real values for local dev. In CI, the same names are set as GitHub repo
# secrets (see .github/workflows/deploy.yml).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
